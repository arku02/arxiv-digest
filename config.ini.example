# 複製這個檔案為 config.ini，填入自己的設定。
# config.ini 已被 .gitignore 忽略，不會進版控。

[DB]
host = localhost
user = root
password = YOUR_PASSWORD_HERE
port = 3306
# 刻意與期中專案的 arxiv_db 分開，避免兩邊的 schema 互相干擾
database = arxiv_digest_db

[ARXIV]
# 要訂閱的分類，逗號分隔。語法同 arXiv API，例如 cs.AI, cs.CL, cs.CV, cs.LG
# 這 3 個分類合計約 263 篇/天（2026/09/14–09/20 實測）
categories = cs.AI, cs.CL, cs.CV
# 單次 API 請求抓幾筆（arXiv 單次上限 2000，分頁會自動處理）
page_size = 100
# 單次執行最多抓幾筆，防止久未執行時一口氣拉爆。
# daily 含回看約查 5 天；3 個分類約 1300～1500 筆，至少設 2000
max_results = 3000
# 每次 API 請求之間隔幾秒（arXiv 官方建議至少 3 秒）
request_delay = 3.0
# 從未執行過時，第一次要回溯幾天
initial_backfill_days = 1
# daily 每次往回重查幾天。arXiv 論文公告後 API 才查得到，
# 週五截止後的投稿要到週一晚上才公告，設太小會漏抓。設 0 可關閉
lookback_days = 4

[TELEGRAM]
# 跟 @BotFather 對話 /newbot 之後拿到的 token
bot_token = YOUR_BOT_TOKEN_HERE
# 你自己的數字 ID，跟 @userinfobot 對話就會回給你
# 填好後要先在 Telegram 對自己的 bot 按一次 Start，bot 才能傳訊息給你
chat_id = YOUR_CHAT_ID_HERE
# 每天推送幾篇（P2 先隨機取樣，P3 才換成評分最高的前幾名）
daily_limit = 10

[TRANSLATE]
# 推送時用本機 Ollama 把標題與摘要翻成繁體中文（免費，不經過雲端）
# 先安裝 Ollama（ollama.com）並下載模型：ollama pull qwen3.5:9b
# 翻譯失敗或 Ollama 沒在執行時，會自動改推英文
enabled = false
model = qwen3.5:9b
url = http://127.0.0.1:11434
# 單篇翻譯最多等幾秒；用 CPU 跑 9B 模型每篇約 45～65 秒
timeout = 300

[RETRY]
# 抓取失敗時（例如 arXiv 回 429 請求太頻繁），push 會暫停，並在 Telegram 通知一次。
# 之後每小時的 collect 會在本機時間 start_hour～end_hour 之間重抓，成功就補推。
# 設 enabled = false 可關閉自動補抓
enabled = true
start_hour = 10
end_hour = 22
